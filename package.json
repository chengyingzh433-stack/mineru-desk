{
  "name": "mineru-desk",
  "version": "0.3.1",
  "private": true,
  "description": "A local-first MinerU desktop workbench with shared agent task history",
  "main": "desktop.cjs",
  "scripts": {
    "start": "electron .",
    "service": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "mineru-open-api": "0.5.9",
    "dompurify": "^3.3.0",
    "katex": "^0.16.22",
    "lucide": "^0.577.0",
    "marked": "^17.0.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.mineru.desk",
    "productName": "MinerU Desk",
    "asar": false,
    "files": ["desktop.cjs", "preload.cjs", "server.mjs", "core.mjs", "portable.cjs", "agent.mjs", "storage.mjs", "task-maintenance.mjs", "bundled-models.mjs", "progress.mjs", "hardware.mjs", "cli.mjs", "web/**", "package.json", "使用说明.md"],
    "win": { "target": "dir" },
    "directories": { "output": "release" }
  }
}
